<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
  <main class="container mx-auto bg-gray-50 shadow-lg rounded-xl p-10 mt-10 max-w-6xl">
      <h2 class="text-3xl text-red-500 font-bold text-center mb-6">
        Here are our registered homes:
      </h2>
  <div class="flex flex-wrap justify-center gap-10">
        <% registeredHomes.forEach(home => { %>
          <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl hover:scale-105 transition duration-300 w-full max-w-sm border border-gray-100">
            <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="w-full h-56 object-cover">
            <div class="p-6 flex flex-col gap-3">
              <h3 class="text-2xl font-bold text-gray-800 mb-1 truncate"><%= home.houseName %></h3>
              <p class="text-gray-500 mb-1 flex items-center">
                <span class="truncate"><%= home.location %></span>
              </p>
              <div class="flex justify-between items-center mb-2">
                <span class="text-lg font-bold text-red-500">Rs<%= home.price %> / night</span>
                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-yellow-400 mr-1">
                    <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-gray-700"><%= home.rating %></span>
                </div>
              </div>
              <p class="text-gray-700 text-base italic mb-2 line-clamp-3"><%= home.description %></p>
              <div class="flex gap-2 mt-2">
                <a class="bg-gradient-to-r from-blue-400 to-blue-600 text-white font-bold rounded-xl px-5 py-2 shadow hover:from-blue-500 hover:to-blue-700 transition-all duration-200" href="/homes/<%= home._id %>">Details</a>
                <%- include('../partials/favourite', {home: home}) %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>
