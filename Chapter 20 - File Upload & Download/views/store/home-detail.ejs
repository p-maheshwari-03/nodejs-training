<%- include('../partials/head') %>
    </head>
    <body>
        <%- include('../partials/nav') %>
        <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-5xl">
            <div class="flex flex-col gap-8">
                <div class="w-full rounded-lg overflow-hidden">
                    <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="w-full h-64 md:h-80 object-cover rounded-lg shadow-md">
                </div>
                <div class="flex flex-col md:flex-row gap-8">
                    <div class="md:w-2/3">
                        <h1 class="text-4xl font-bold text-gray-800 mb-2"><%= home.houseName %></h1>
                        <div class="flex items-center gap-4 mb-4">
                            <span class="text-yellow-500 text-xl">★</span>
                            <span class="text-lg font-semibold text-gray-700"><%= home.rating %>/5</span>
                            <span class="text-gray-600 text-base"><%= home.location %></span>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div>
                                <h2 class="text-2xl font-bold text-gray-800 mb-4">Property Details</h2>
                                <h3 class="text-lg font-semibold text-gray-700 mb-1">Description</h3>
                                <p class="text-gray-600 text-base mb-4"><%= home.description %></p>
                                <% if (home.houseRulesUrl) { %>
                                    <a href="<%= home.houseRulesUrl %>" download class="flex items-center text-blue-600 text-base font-medium hover:underline mb-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v12m0 0l-4-4m4 4l4-4" />
                                        </svg>
                                        Download House Rules
                                    </a>
                                <% } %>
                                <div class="mt-6">
                                    <%- include('../partials/favourite') %>
                                </div>
                            </div>
                            <div>
                                <h3 class="text-lg font-semibold text-gray-700 mb-2">Features</h3>
                                <ul class="list-none space-y-2">
                                    <li class="flex items-center">
                                        <svg class="h-5 w-5 text-blue-500 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                        </svg>
                                        Prime Location
                                    </li>
                                    <li class="flex items-center">
                                        <svg class="h-5 w-5 text-blue-500 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                        </svg>
                                        Highly Rated
                                    </li>
                                    <li class="flex items-center">
                                        <svg class="h-5 w-5 text-blue-500 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                        </svg>
                                        Modern Amenities
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>
